# Copy to .env on the dedicated Linux gateway. Never commit real values.
# This host must not share the employee calling connection or LiveKit signing key.
PUBLIC_CALLING_LIVEKIT_URL=wss://calls.example.org
PUBLIC_CALLING_LIVEKIT_API_KEY=replace-with-random-key
PUBLIC_CALLING_LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
PUBLIC_CALLING_TURN_DOMAIN=turn.example.org
PUBLIC_CALLING_REDIS_PASSWORD=replace-with-at-least-32-random-alphanumeric-characters
PUBLIC_CALLING_API_BASE_URL=https://api.example.org/prod
PUBLIC_CALLING_BFF_SECRET=replace-with-at-least-32-random-characters

# Provisioning script only. Do not pass these into the public website build.
PUBLIC_CALLING_ENVIRONMENT=stage
PUBLIC_CALLING_TELNYX_API_KEY=
PUBLIC_CALLING_SIP_USERNAME=
PUBLIC_CALLING_SIP_PASSWORD=
PUBLIC_CALLING_CALLER_NUMBER=
PUBLIC_CALLING_MAX_CONCURRENT=2
PUBLIC_CALLING_TELNYX_DAILY_SPEND=2.00
PUBLIC_CALLING_TELNYX_MAX_RATE=0.02
PUBLIC_CALLING_TELNYX_VERIFY_DAILY_SPEND=1.00
# Read GET /v2/verify_profiles/templates and select a template containing app_name and code.
PUBLIC_CALLING_TELNYX_VERIFY_TEMPLATE_ID=
